# ── Context-spine environment (TEST project only) ───────────────────────────
# Copy this file to .env and fill in the values:   cp .env.example .env
#
# .env is git-ignored — never commit it. Prod is read-only via its MCP server,
# so prod credentials never belong here. 🔒 = secret.
#
# Where to find each value:
#   SUPABASE_URL               Test project API URL (derived from the project ref)
#   SUPABASE_SERVICE_ROLE_KEY  🔒 Settings → API → Project API keys → service_role
#   DATABASE_URL               🔒 Top-bar "Connect" → URI (Session pooler/Direct, port 5432)
#   ANTHROPIC_API_KEY          🔒 console.anthropic.com → API keys (write-path Sonnet extractor)
#   SCHEDULE_SHEET_ID          Google Sheet id of the firm schedule (from its URL)
#   GOOGLE_APPLICATION_CREDENTIALS  Path to a Google service-account JSON (Sheets read access)
#   DEFAULT_TENANT_ID          Tenant the MCP server pins every tool call to (single-tenant v1)
# ─────────────────────────────────────────────────────────────────────────────

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
ANTHROPIC_API_KEY=

# Phase 2 — Google Sheet schedule sync (live sync only; tests stub the reader)
SCHEDULE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Phase 3 — MCP server: the single tenant every tool call is fixed to
DEFAULT_TENANT_ID=

# Phase 4 — Gmail email ingestion (live only; tests stub the fetcher). OAuth2
# creds for the connected mailbox, or swap in a Workspace service account.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
