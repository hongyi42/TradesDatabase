# ── Context-spine environment (TEST project only) ───────────────────────────
# Copy this file to .env and fill in the values:   cp .env.example .env
#
# .env is git-ignored — never commit it. Prod is read-only via its MCP server,
# so prod credentials never belong here. 🔒 = secret.
#
# Where to find each value:
#   SUPABASE_URL               Test project API URL (derived from the project ref)
#   SUPABASE_SERVICE_ROLE_KEY  🔒 Settings → API → Project API keys → service_role
#   DATABASE_URL               🔒 Top-bar "Connect" → URI (Session pooler/Direct, port 5432)
#   ANTHROPIC_API_KEY          🔒 console.anthropic.com → API keys (write-path Sonnet extractor)
#   SCHEDULE_SHEET_ID          Google Sheet id of the firm schedule (from its URL)
#   GOOGLE_APPLICATION_CREDENTIALS  Path to a Google service-account JSON (Sheets read access)
#   DEFAULT_TENANT_ID          Tenant the stdio MCP server pins every tool call to (single-tenant v1)
#   DEFAULT_TECHNICIAN_REF     Technician the stdio MCP server pins (single-identity dev/test)
#   GATEWAY_IDENTITY_SECRET    🔒 Shared with the gateway; signs/verifies the identity header (central HTTP)
#   MCP_HTTP_PORT              Port the central HTTP MCP server listens on (default 8080)
#   ALLOWED_CLIENT_IPS         Optional comma-list of source IPs allowed to reach the HTTP server
# ─────────────────────────────────────────────────────────────────────────────

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
ANTHROPIC_API_KEY=

# Phase 2 — Google Sheet schedule sync (live sync only; tests stub the reader)
SCHEDULE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Phase 3 — stdio MCP server: the single (tenant, technician) every tool call is fixed to
DEFAULT_TENANT_ID=
DEFAULT_TECHNICIAN_REF=

# Architecture A — central HTTP MCP server (mcp:serve:http). Identity arrives per
# request in the gateway's signed header; mTLS + private network are deploy infra.
GATEWAY_IDENTITY_SECRET=
MCP_HTTP_PORT=8080
ALLOWED_CLIENT_IPS=

# Phase 4 — Gmail email ingestion (live only; tests stub the fetcher). OAuth2
# creds for the connected mailbox, or swap in a Workspace service account.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Composio inbound webhook — signing secret (Standard Webhooks / Svix scheme).
# Form: whsec_<base64>. Composio sends webhook-id, webhook-timestamp, webhook-signature
# headers; the handler HMAC-SHA256s `${id}.${timestamp}.${body}` with the base64-decoded
# secret and matches a v1,<base64> entry. Stale timestamps (>5 min) and bad/missing
# signatures are rejected 401.
COMPOSIO_WEBHOOK_SECRET=

# 🔒 Composio API key — dev helper scripts only (scripts/composio-*.mjs, run with
# `node -r dotenv/config`). Control-plane secret: mints access for ALL tenants, so
# it must never reach a sandbox (same custody rule as GATEWAY_IDENTITY_SECRET).
COMPOSIO_API_KEY=
