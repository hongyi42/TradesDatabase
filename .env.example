# ── Context-spine environment (TEST project only) ───────────────────────────
# Copy this file to .env and fill in the values:   cp .env.example .env
#
# .env is git-ignored — never commit it. Prod is read-only via its MCP server,
# so prod credentials never belong here. 🔒 = secret.
#
# Where to find each value:
#   SUPABASE_URL               Test project API URL (derived from the project ref)
#   SUPABASE_SERVICE_ROLE_KEY  🔒 Settings → API → Project API keys → service_role
#   DATABASE_URL               🔒 Top-bar "Connect" → URI (Session pooler/Direct, port 5432)
#   MODEL_PROVIDER             'openai' (default → GLM-5.2) or 'anthropic'. Selects the transport
#                              for ALL four forced-tool calls (classify/extract/brief/answer).
#   INFERENCE_API_KEY          🔒 Fireworks API key — used when MODEL_PROVIDER=openai
#   INFERENCE_BASE_URL         OpenAI-compatible base (default https://openrouter.ai/api/v1)
#   INFERENCE_MODEL            Model id for that endpoint (default z-ai/glm-5.3)
#                              MUST match the endpoint: a DeepInfra-era id sent to Fireworks 404s.
#   ANTHROPIC_API_KEY          🔒 console.anthropic.com → API keys; used when MODEL_PROVIDER=anthropic
#   ANTHROPIC_MODEL            Optional override (default claude-sonnet-4-6)
#   DEFAULT_TENANT_ID          Tenant the stdio MCP server pins every tool call to (single-tenant v1)
#   DEFAULT_TECHNICIAN_REF     Technician the stdio MCP server pins (single-identity dev/test)
#   GATEWAY_IDENTITY_SECRET    🔒 Shared with the gateway; signs/verifies the identity header (central HTTP)
#   MCP_HTTP_PORT              Port the central HTTP MCP server listens on (default 8080)
#   ALLOWED_CLIENT_IPS         Optional comma-list of source IPs allowed to reach the HTTP server
# ─────────────────────────────────────────────────────────────────────────────

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ── Model transport (src/model/forcedTool.ts) ────────────────────────────────
# One switch drives all four forced-tool calls: classify (the work/personal gate
# on the append-only L1 insert), extract, brief, answer. Flip MODEL_PROVIDER to
# 'anthropic' to revert to Claude without a code change — that path is kept whole.
MODEL_PROVIDER=openai
INFERENCE_API_KEY=
INFERENCE_BASE_URL=https://openrouter.ai/api/v1
INFERENCE_MODEL=z-ai/glm-5.3
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# (SCHEDULE_SHEET_ID / GOOGLE_APPLICATION_CREDENTIALS retired 2026-07-15 — the
# sheet sync is gone; the DB owns the schedule.)

# Phase 3 — stdio MCP server: the single (tenant, technician) every tool call is fixed to
DEFAULT_TENANT_ID=
DEFAULT_TECHNICIAN_REF=

# Architecture A — central HTTP MCP server (mcp:serve:http). Identity arrives per
# request in the gateway's signed header; mTLS + private network are deploy infra.
GATEWAY_IDENTITY_SECRET=
MCP_HTTP_PORT=8080
ALLOWED_CLIENT_IPS=

# (Gmail OAuth2 creds — GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET /
# GMAIL_REFRESH_TOKEN — were REMOVED in rung 10, 2026-09-07, with the direct
# Gmail puller that read them. Email arrives as a Composio webhook: the mailbox
# is paired through Composio-managed OAuth, and no Google credential is held by
# this app at all.)

# Composio inbound webhook — signing secret (Standard Webhooks shape). The secret is a
# RAW string (Composio issues a bare hex string — no whsec_ prefix, and it is used as the
# HMAC key as-is, NOT base64-decoded; verified live 2026-07-02, see src/inbound/webhook.ts).
# Read/set it via the SDK-managed webhook subscription (`triggers.setWebhookSubscription()` /
# GET /api/v3/webhook_subscriptions — there is no dashboard page). Composio sends webhook-id,
# webhook-timestamp, webhook-signature headers; the handler HMAC-SHA256s
# `${id}.${timestamp}.${body}` and matches a v1,<base64> entry. Stale timestamps (>5 min)
# and bad/missing signatures are rejected 401. Must match the deployed service's value.
COMPOSIO_WEBHOOK_SECRET=

# 🔒 Composio API key — control-plane secret: dev helper scripts
# (scripts/composio-*.mjs, scripts/provision-session.mjs, `node -r dotenv/config`)
# AND the Render lifecycle cron (session provisioning + execution-log ingestion;
# both steps skip cleanly when unset). Mints access for ALL tenants, so it must
# never reach a sandbox (same custody rule as GATEWAY_IDENTITY_SECRET).
COMPOSIO_API_KEY=

# 🔒 Brave Search API key — powers the web_search spine tool (Feature E). Lives
# on the spine server only, never in a sandbox. Metered since Brave removed the
# free tier in Feb 2026 (~$0.005/query), so usage is billed per request and
# recorded to the cost ledger via the web_requests backfill.
BRAVE_API_KEY=

# 🔒 Operator dashboard bearer token — gates /admin, the ONE cross-tenant read
# surface (every other surface resolves to a single roster row). Generate with
# `openssl rand -hex 32`. UNSET => the route answers 503, never open. Must match
# the value in the Render web service env. The four cost tables also have RLS
# enabled (migration 20260725140000) so the publishable anon key cannot read
# them straight from PostgREST and go around this token.
ADMIN_DASHBOARD_TOKEN=
# Optional: override where web/admin is served from (mirrors BOARD_STATIC_DIR).
ADMIN_STATIC_DIR=

# ── Inbound phone-call capture (SignalWire + AssemblyAI; plan 2026-08-04) ─────
# Telephony = SignalWire (Twilio-compatible LaML). The voice webhook returns cXML
# that plays a recorded-call consent <Say>, then <Dial record>-forwards to the
# tenant's line; the RecordingStatusCallback enqueues; a worker downloads the
# recording (HTTP Basic PROJECT_ID:API_TOKEN), copies it to the private call-audio
# bucket, and transcribes via AssemblyAI.
#   SIGNALWIRE_SPACE_URL       e.g. https://<space>.signalwire.com
#   SIGNALWIRE_PROJECT_ID      SignalWire project id (also the Basic-auth username for media download)
#   SIGNALWIRE_API_TOKEN       🔒 the PSK… SIGNING key — validates the X-SignalWire-Signature on inbound
#                              webhooks. Signing only; it 401s on the REST API.
#   SIGNALWIRE_REST_TOKEN      🔒 the PT… REST API Token — Basic-auth for the recording-media download.
#                              Scopes MUST include Voice + Management (Management is required to GET a
#                              protected recording; Voice alone → 401). Distinct from the signing key above.
#                              (X-SignalWire-Signature); there is NO separate webhook secret
#   SIGNALWIRE_WEBHOOK_BASE_URL The public https base SignalWire posts to (e.g. the Render URL) —
#                              used to reconstruct the signed request URL for validateRequest AND
#                              to build the absolute recordingStatusCallback URL. No trailing slash.
#   ASSEMBLYAI_API_KEY         🔒 STT — transcribes the stored recording via a signed URL
#   CALL_AUDIO_BUCKET          Private Storage bucket for recordings (default call-audio)
#   CALL_AUDIO_RETENTION_DAYS  Days to keep audio before the purge deletes it; 0 = transcript-only
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_REST_TOKEN=
SIGNALWIRE_WEBHOOK_BASE_URL=
ASSEMBLYAI_API_KEY=
CALL_AUDIO_BUCKET=call-audio
CALL_AUDIO_RETENTION_DAYS=30
