# ── Context-spine environment (TEST project only) ───────────────────────────
# Copy this file to .env and fill in the blanks:
#     cp .env.example .env
#
# .env is git-ignored — never commit it. Prod credentials do NOT belong here;
# the prod project is reached read-only through its MCP server only.
# ─────────────────────────────────────────────────────────────────────────────

# Test project API URL (not secret — derived from the project ref)
SUPABASE_URL=https://<your-test-project-ref>.supabase.co

# Test project service-role key  🔒 SECRET (bypasses RLS)
# Dashboard:  Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Test project direct connection string  🔒 SECRET (embeds the DB password)
# Top-bar "Connect" button → Connection string → URI (Session pooler or Direct, port 5432)
DATABASE_URL=
