# ── Test-suite environment: LOCAL Supabase stack ONLY ───────────────────────
# Copy to .env.test:   cp .env.test.example .env.test     (.env.test is git-ignored)
#
# src/test.setup.ts loads .env first, then this file with override — so tests
# hit the local Docker stack while .env keeps serving the live helper scripts.
# All three values are printed by `npx supabase start` (or `npx supabase status`).
# The guard in src/testEnvGuard.ts refuses to run tests against anything that
# is not 127.0.0.1/localhost — a hosted URL here will (correctly) fail the suite.
#
#   SUPABASE_URL               "Project URL"  → http://127.0.0.1:54321
#   SUPABASE_SERVICE_ROLE_KEY  "Secret" key   → sb_secret_...
#   DATABASE_URL               "Database URL" → postgresql://postgres:postgres@127.0.0.1:54322/postgres
# ─────────────────────────────────────────────────────────────────────────────

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
