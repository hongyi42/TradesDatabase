# macOS Finder metadata
.DS_Store

# Dependencies
# No trailing slash, deliberately: `node_modules/` matches a DIRECTORY only, so
# a `node_modules` SYMLINK slipped past it and was committed (PR #154, 2026-08-19)
# pointing at an absolute path on one developer's laptop — a dangling link on
# every other machine, including Render builds and fresh clones.
node_modules

# Build output
dist/

# Env / secrets — never commit
.env
.env.test
supabase/.env

# SSH / private keys — never commit (belt-and-suspenders; keys belong in ~/.ssh)
*.pem
*.key
id_rsa
id_ed25519

# Supabase CLI local state
supabase/.temp/

# Inbound webhook debug capture (INBOUND_DEBUG=1) — holds real email content
inbound-last.json

# Date-eval run artifacts (manifests, trajectories, reports) — regenerate with npm run date-eval:plan
date-eval-runs/

# Spine-eval run artifacts (world manifest, trajectories, reports) — regenerate with npm run spine-eval:world
spine-eval-runs/
