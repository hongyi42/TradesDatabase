# Dependencies
node_modules/

# Build output
dist/

# Python bytecode (Box_Setup_Stuff/*.py)
__pycache__/
*.pyc

# Env / secrets — never commit
.env
.env.test
supabase/.env

# SSH / private keys — never commit (belt-and-suspenders; keys belong in ~/.ssh)
*.pem
*.key
id_rsa
id_ed25519

# Supabase CLI local state
supabase/.temp/

# Per-developer Claude Code settings — machine-local, never shared.
# (.claude/settings.json IS committed; only the .local. variant is personal.)
.claude/settings.local.json

# Inbound webhook debug capture (INBOUND_DEBUG=1) — holds real email content
inbound-last.json

# macOS Finder metadata (arrives with any drag/copy into the repo)
.DS_Store

# Impeccable design tooling — installed with `npx impeccable install`, 3.4 MB of
# vendored skill files that regenerate. The design artifacts we actually care
# about are copied into docs/design/ instead.
.claude/skills/impeccable/
.impeccable/

# Third-party skills installed from GitHub (`npx skills add ...`). Same rule as
# impeccable above: the install is reproducible from skills-lock.json, which IS
# committed, so the vendored copy doesn't belong in the repo. `.agents/skills/`
# holds the real files; `.claude/skills/<name>` is a symlink into it — ignore both
# halves together or the symlink dangles on a fresh clone.
.agents/
.claude/skills/redesign-existing-projects
.claude/skills/ui-ux-pro-max
