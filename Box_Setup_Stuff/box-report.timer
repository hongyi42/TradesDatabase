[Unit]
Description=Run box-report.sh every 5 minutes

[Timer]
# Matches the inference medic's cadence, so an incident's box-side context and
# its model-side context land in the same 5-minute window and line up in
# ops_events without anyone having to reconcile two schedules.
OnBootSec=3min
OnUnitActiveSec=5min
AccuracySec=30s
# Spread ticks across the fleet so N boxes do not all POST /control/ops on the
# same second. Matters once there is more than one box; harmless before that.
RandomizedDelaySec=20s
Persistent=false
Unit=box-report.service

[Install]
WantedBy=timers.target
