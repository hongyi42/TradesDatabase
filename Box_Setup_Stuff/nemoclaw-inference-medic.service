# /etc/systemd/system/nemoclaw-inference-medic.service
# Assert the production Fireworks/GLM-5.2-fast gateway inference route,
# self-healing the drift that onboard/rebuild introduces (resets to the
# rate-limited NVIDIA default). Runs as the gateway owner. Triggered on boot +
# every 5 min by nemoclaw-inference-medic.timer. See
# nemoclaw-inference-medic.sh for the why.
[Unit]
Description=Assert Fireworks/GLM-5.2-fast gateway inference route (self-heal onboard/reboot drift)
After=docker.service nemoclaw-boot.service
Wants=docker.service
# Carry the verdict off the box. The medic reports honestly to the journal, and
# nobody reads the journal — which is how six agent-outage windows on
# 2026-08-12 went unnoticed. These fire in SEPARATE units so a broken reporter
# can never mark the medic failed or hold its tick open.
OnFailure=ops-report-medic-down.service
OnSuccess=ops-report-medic-ok.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
ExecStart=/usr/local/sbin/nemoclaw-inference-medic.sh

[Install]
WantedBy=multi-user.target
