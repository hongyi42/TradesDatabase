# /etc/systemd/system/nemoclaw-inference-medic.timer
# Runs the inference-medic shortly after boot and every 5 min thereafter, so a
# reboot revert, a post-onboard/rebuild drift, OR a provider outage (v2
# failover) is corrected within ~5 min without anyone remembering a manual
# flip. (Was 15 min when the medic only fixed drift; failover makes the
# interval the worst-case dead-agent window, so it was tightened 2026-07-11.)
[Unit]
Description=Assert healthy GLM-5.2 inference route (DeepInfra primary, NVIDIA failover)

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
