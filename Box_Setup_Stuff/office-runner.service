# /etc/systemd/system/office-runner.service
# Inject queued agent-addressed office messages as agent turns (build 5.5
# Phase 3, plan 2026-08-31). Pulls the spine's /control/office queue and
# reports per-item outcomes; the spine owns retries. The script ALWAYS exits 0
# (ops-report.sh discipline) — a delivery problem is the spine's row state,
# never a red unit on the box.
[Unit]
Description=Inject queued office messages as agent turns (spine /control/office)
After=docker.service nemoclaw-boot.service
Wants=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/office-runner.sh

[Install]
WantedBy=multi-user.target
