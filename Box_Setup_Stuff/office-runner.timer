# /etc/systemd/system/office-runner.timer
# Every 5 min, matching the badge and nudge pulls: a queued office message
# reaches its agent within ~5 min of the planner's tick. Escape hatch:
# `systemctl disable --now office-runner.timer` stops ALL injection instantly
# (the spine keeps serving the rows; nothing is lost).
[Unit]
Description=Run the office-message injector every 5 minutes

[Timer]
OnBootSec=4min30s
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
