# Copy to backup.env on the box (chmod 600) and fill in. NEVER commit the real file.

# The Postgres connection string for the database being backed up.
# Supabase → Project Settings → Database → Connection string (URI).
# Contains the password, which is why this file is gitignored and 600.
SUPABASE_DB_URL=

# ── Off-box copy (OPTIONAL — leave blank to run box-local only) ──────────────────
# Blank means the ONLY copy lives on this box, so it does not survive losing the
# box. That is still far better than no backup: it survives a bad migration, a
# dropped table, and losing the Supabase account. Fill this in to close the last
# gap; no code change is needed.
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2

# ── Alerting (OPTIONAL but strongly recommended) ─────────────────────────────────
# A FAILED backup reports here and reaches Telegram through the existing ops
# pipeline (service name "db-backup"). Same host token ops-report.sh already uses:
# see /etc/nemoclaw/ops-report.env on the box.
OPS_REPORT_URL=https://tradesdatabase.onrender.com/control/ops
HOST_PULL_TOKEN=

# A SUCCEEDED backup pings this. Healthchecks alarms when the pings STOP, which is
# the only way a backup that never ran can announce itself — a dead cron cannot
# report its own death. Create a check with period 1 day / grace 2 hours for a
# nightly backup.
HEALTHCHECK_URL=

# ── Tuning (safe defaults) ───────────────────────────────────────────────────────
# Must be >= the server's major version; pg_dump refuses to dump a newer server.
PGIMAGE=postgres:17-alpine
OUT_DIR=./backups
KEEP_LOCAL=14
