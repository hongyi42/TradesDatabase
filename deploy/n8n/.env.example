# Copy to `.env` on the n8n host and fill in. NEVER commit the real .env.
# (.env is gitignored via deploy/n8n/.gitignore.)

# Generate ONCE, on the host:  openssl rand -hex 32
#
# This key encrypts every credential n8n stores. Back it up off-host in a
# password manager BEFORE creating any credential — the nightly export is
# encrypted with it, so without the key the backups are unrestorable and the
# credentials are gone. Treat it like the service_role key: never in chat,
# never in a commit, never printed to a shared terminal.
N8N_ENCRYPTION_KEY=

# IANA tz name. Schedule triggers are interpreted in this zone, so a mismatch
# with the agent box makes incident timestamps hard to line up. Match the box.
TZ=America/Los_Angeles

# NOTE: there is deliberately no N8N_HOST / WEBHOOK_URL / domain here. n8n binds
# to loopback and is reached over an SSH tunnel; it has no public hostname and
# receives no inbound webhooks. See the header of docker-compose.yml.
