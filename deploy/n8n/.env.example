# Copy to `.env` on the box and fill in. NEVER commit the real .env.
# (.env is gitignored below via deploy/n8n/.gitignore.)

# The subdomain n8n is served on (its DNS A record must point at this box).
N8N_HOST=n8n.example.com

# Generate ONCE with:  openssl rand -hex 32
# Back this up off-box (password manager). It decrypts every stored credential —
# losing it bricks all of them; leaking it exposes all of them.
N8N_ENCRYPTION_KEY=

# IANA tz name, e.g. America/Los_Angeles
TZ=America/Los_Angeles
