{
  "name": "trades-database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p web/portal --noEmit",
    "lint": "eslint .",
    "portal:dev": "vite --config web/portal/vite.config.ts",
    "portal:build": "vite build --config web/portal/vite.config.ts",
    "portal:standalone": "npm run portal:build && node scripts/portal-standalone.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build:server && npm run portal:build",
    "build:server": "tsc -p tsconfig.json",
    "mcp:serve": "node dist/mcp/server.js",
    "mcp:serve:http": "node dist/mcp/httpServer.js",
    "board:worker": "node dist/telegram/boardWorker.js",
    "calls:worker": "node dist/calls/runWorker.js",
    "calls:purge": "node dist/calls/purgeAudio.js",
    "seed": "npm run build && node -r dotenv/config scripts/seed.mjs",
    "seed:local": "npm run seed -- --local",
    "db:push": "npx supabase db push",
    "gen:types": "mkdir -p src/db && npx supabase gen types typescript --linked > src/db/database.types.ts",
    "gen:types:local": "mkdir -p src/db && npx supabase gen types typescript --local > src/db/database.types.ts",
    "job:lifecycle": "node dist/jobs/lifecycle.js"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pg": "^8.22.0",
    "supabase": "^2.107.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@composio/core": "^0.13.1",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.108.2",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.9.1",
    "googleapis": "^173.0.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
